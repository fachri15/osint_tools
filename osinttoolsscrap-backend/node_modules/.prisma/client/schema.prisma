// Prisma Schema for OSINT Tools & Forensic Intelligence
// Database: MySQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// 1. ADMIN USERS (AUTENTIKASI & RBAC)
// ─────────────────────────────────────────────────────────────
model AdminUser {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(150)
  role         String    @default("operator") @db.VarChar(50) // superadmin, operator, analyst
  nip          String?   @db.VarChar(50) // e.g. ANL-7709-ID
  badge        String?   @default("Superadmin") @db.VarChar(50)
  avatar       String?   @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLogin    DateTime? @map("last_login")

  // Relasional
  createdClients Client[]   @relation("AdminCreatedClients")
  auditLogs      AuditLog[] @relation("AdminAuditLogs")

  @@map("admin_users")
}

// ─────────────────────────────────────────────────────────────
// 2. DATA KLIEN (360° PORTFOLIO & TRACKING)
// ─────────────────────────────────────────────────────────────
model Client {
  id               Int      @id @default(autoincrement())
  clientCode       String   @unique @map("client_code") @db.VarChar(50) // e.g. KLIEN-089 / CLI-20261013-001
  fullName         String   @map("full_name") @db.VarChar(200)
  firstName        String?  @map("first_name") @db.VarChar(100)
  middleName       String?  @map("middle_name") @db.VarChar(100)
  lastName         String?  @map("last_name") @db.VarChar(100)
  nik              String?  @db.VarChar(50) // Masked: 317109******0004
  nikFull          String?  @map("nik_full") @db.VarChar(50) // Unmasked: 3171091405960004
  birthDate        String?  @map("birth_date") @db.VarChar(50)
  gender           String?  @default("Laki-laki") @db.VarChar(30)
  phone            String?  @db.VarChar(50)
  email            String?  @db.VarChar(150)
  address          String?  @db.Text
  emergencyContact String?  @map("emergency_contact") @db.Text
  familyName       String?  @map("family_name") @db.Text
  doxingKeywords   String?  @map("doxing_keywords") @db.Text
  socialMedia      Json?    @map("social_media")
  caseCategory     String?  @default("Teror Pinjol Ilegal & Doxing Kontak") @map("case_category") @db.VarChar(150)
  threatLevel      String?  @default("CRITICAL") @map("threat_level") @db.VarChar(30)
  riskScore        Int      @default(75) @map("risk_score")
  status           String   @default("Mitigasi L1 Aktif") @db.VarChar(50)
  activeThreats    Int      @default(1) @map("active_threats")
  resolvedThreats  Int      @default(0) @map("resolved_threats")
  involvedFintechs Json?    @map("involved_fintechs")
  assignedAnalyst  String?  @default("ANL-7709-ID (Aditya Wardhana)") @map("assigned_analyst") @db.VarChar(150)
  legalBasis       String?  @map("legal_basis") @db.Text
  notes            String?  @db.Text
  createdBy        String?  @default("admin") @map("created_by") @db.VarChar(100)
  adminUserId      Int?     @map("admin_user_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relasional
  adminUser        AdminUser?        @relation("AdminCreatedClients", fields: [adminUserId], references: [id], onDelete: SetNull)
  scans            ScanHistory[]
  dcInvestigations DcInvestigation[]
  removalCases     RemovalCase[]
  policeReports    PoliceReport[]

  @@map("clients")
}

// ─────────────────────────────────────────────────────────────
// 3. RIWAYAT SCAN DIAGNOSA JEJAK DIGITAL
// ─────────────────────────────────────────────────────────────
model ScanHistory {
  id              Int      @id @default(autoincrement())
  clientId        Int?     @map("client_id")
  targetName      String   @map("target_name") @db.VarChar(200)
  targetPhone     String?  @map("target_phone") @db.VarChar(50)
  targetEmail     String?  @map("target_email") @db.VarChar(150)
  targetNik       String?  @map("target_nik") @db.VarChar(50)
  targetInstagram String?  @map("target_instagram") @db.VarChar(100)
  targetTiktok    String?  @map("target_tiktok") @db.VarChar(100)
  targetFacebook  String?  @map("target_facebook") @db.VarChar(100)
  targetTwitter   String?  @map("target_twitter") @db.VarChar(100)
  targetLinkedin  String?  @map("target_linkedin") @db.VarChar(100)
  targetThreads   String?  @map("target_threads") @db.VarChar(100)
  targetYoutube   String?  @map("target_youtube") @db.VarChar(100)
  spouseFamily    String?  @map("spouse_family") @db.Text
  keywords        String?  @db.Text
  riskScore       Int?     @map("risk_score")
  riskCategory    String?  @map("risk_category") @db.VarChar(50) // KRITIS, TINGGI, SEDANG, RENDAH, AMAN
  riskColor       String?  @map("risk_color") @db.VarChar(30) // red, orange, yellow, green
  dorkFound       Int      @default(0) @map("dork_found")
  breachCount     Int      @default(0) @map("breach_count")
  socialPlatforms Json?    @map("social_platforms")
  status          String   @default("selesai") @db.VarChar(50)
  scanMode        String   @default("real") @map("scan_mode") @db.VarChar(30)
  resultJson      Json?    @map("result_json")
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  // Relasional
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@map("scan_history")
}

// ─────────────────────────────────────────────────────────────
// 4. INVESTIGASI NOMOR DEBT COLLECTOR (DC)
// ─────────────────────────────────────────────────────────────
model DcInvestigation {
  id              Int      @id @default(autoincrement())
  clientId        Int?     @map("client_id")
  dcPhone         String   @map("dc_phone") @db.VarChar(50)
  operator        String?  @db.VarChar(100)
  region          String?  @db.VarChar(150)
  phoneType       String?  @map("phone_type") @db.VarChar(100)
  hlrCity         String?  @map("hlr_city") @db.VarChar(100)
  truecallerName  String?  @map("truecaller_name") @db.VarChar(150)
  isSpam          Boolean  @default(false) @map("is_spam")
  getcontactCount Int      @default(0) @map("getcontact_count")
  hasFraudReport  Boolean  @default(false) @map("has_fraud_report")
  phoneScore      Int      @default(0) @map("phone_score")
  voipDetected    Boolean  @default(false) @map("voip_detected")
  riskLevel       String?  @map("risk_level") @db.VarChar(50)
  status          String   @default("selesai") @db.VarChar(50)
  resultJson      Json?    @map("result_json")
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  // Relasional
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@map("dc_investigations")
}

// ─────────────────────────────────────────────────────────────
// 5. ASISTEN REMOVAL & PROGRESS TRACKING
// ─────────────────────────────────────────────────────────────
model RemovalCase {
  id              Int       @id @default(autoincrement())
  caseCode        String    @unique @map("case_code") @db.VarChar(50) // REM-2026-081
  clientId        Int?      @map("client_id")
  clientName      String    @map("client_name") @db.VarChar(200)
  clientPhone     String?   @map("client_phone") @db.VarChar(50)
  targetUrl       String    @map("target_url") @db.Text
  targetSnippet   String?   @map("target_snippet") @db.Text
  targetKeyword   String?   @map("target_keyword") @db.VarChar(200)
  platform        String?   @db.VarChar(100) // Telegram, Pastebin, Google
  platformIcon    String?   @map("platform_icon") @db.VarChar(50)
  leakType        String?   @map("leak_type") @db.VarChar(150)
  removalType     String    @default("Google Outdated Content") @map("removal_type") @db.VarChar(100)
  status          String    @default("Draft") @db.VarChar(50)
  statusCode      String    @default("IN_PROGRESS") @map("status_code") @db.VarChar(50)
  progressPercent Int       @default(10) @map("progress_percent")
  ticketId        String?   @map("ticket_id") @db.VarChar(100)
  legalRef        String?   @map("legal_ref") @db.Text
  evidenceCount   Int       @default(1) @map("evidence_count")
  aiGuidance      String?   @map("ai_guidance") @db.Text
  legalText       String?   @map("legal_text") @db.Text
  lastCheckedAt   DateTime? @map("last_checked_at")
  httpStatusCode  Int?      @map("http_status_code")
  isIndexed       Boolean   @default(true) @map("is_indexed")
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relasional
  client Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  logs   RemovalLog[]

  @@map("removal_cases")
}

// ─────────────────────────────────────────────────────────────
// 6. LOG HISTORI PENANGANAN REMOVAL CASE
// ─────────────────────────────────────────────────────────────
model RemovalLog {
  id          Int      @id @default(autoincrement())
  caseId      Int      @map("case_id")
  actionType  String   @map("action_type") @db.VarChar(100)
  oldStatus   String?  @map("old_status") @db.VarChar(50)
  newStatus   String?  @map("new_status") @db.VarChar(50)
  description String?  @db.Text
  actor       String   @default("Operator/AI System") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relasional
  case RemovalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("removal_logs")
}

// ─────────────────────────────────────────────────────────────
// 7. METADATA LAPORAN POLISI (PDF BAP RESMI)
// ─────────────────────────────────────────────────────────────
model PoliceReport {
  id              Int      @id @default(autoincrement())
  clientId        Int?     @map("client_id")
  reportNumber    String?  @map("report_number") @db.VarChar(100) // LP/B/089/X/2026/SPKT.DITTIPIDSIBER
  reporterName    String   @map("reporter_name") @db.VarChar(200)
  reporterNik     String?  @map("reporter_nik") @db.VarChar(50)
  reporterPhone   String?  @map("reporter_phone") @db.VarChar(50)
  reporterAddress String?  @map("reporter_address") @db.Text
  dcPhone         String?  @map("dc_phone") @db.VarChar(50)
  suspectAlias    String?  @map("suspect_alias") @db.VarChar(150)
  suspectAccount  String?  @map("suspect_account") @db.VarChar(150)
  incidentSummary String?  @map("incident_summary") @db.Text
  chronologyText  String?  @map("chronology_text") @db.Text
  filename        String?  @db.VarChar(255)
  status          String   @default("generated") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at")

  // Relasional
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@map("police_reports")
}

// ─────────────────────────────────────────────────────────────
// 8. AUDIT LOG FORENSIK (IMMUTABLE AUDIT TRAIL)
// ─────────────────────────────────────────────────────────────
model AuditLog {
  id          Int      @id @default(autoincrement())
  logCode     String   @map("log_code") @db.VarChar(50) // LOG-9921
  module      String   @db.VarChar(100) // INVESTIGASI-DC, ASISTEN-REMOVAL, etc.
  actor       String   @db.VarChar(150)
  action      String   @db.VarChar(200)
  target      String   @db.VarChar(255)
  result      String   @db.VarChar(255)
  hash        String   @db.VarChar(100) // sha256:...
  badge       String?  @db.VarChar(100)
  adminUserId Int?     @map("admin_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relasional
  adminUser AdminUser? @relation("AdminAuditLogs", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// 9. TATA KELOLA & PENGATURAN API GATEWAY
// ─────────────────────────────────────────────────────────────
model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ─────────────────────────────────────────────────────────────
// 10. REMOVAL REQUESTS (LEGACY COMPATIBILITY)
// ─────────────────────────────────────────────────────────────
model RemovalRequest {
  id          Int      @id @default(autoincrement())
  targetName  String?  @map("target_name") @db.VarChar(200)
  targetUrl   String?  @map("target_url") @db.Text
  wordTerm    String?  @map("word_term") @db.VarChar(200)
  removalType String?  @map("removal_type") @db.VarChar(100)
  status      String   @default("draft") @db.VarChar(50)
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("removal_requests")
}
