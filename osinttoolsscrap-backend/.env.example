# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MySQL / TiDB / Aiven / PlanetScale)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"

# Individual DB Config
DB_HOST="localhost"
DB_PORT=3306
DB_USER="USER"
DB_PASSWORD="PASSWORD"
DB_NAME="DATABASE_NAME"

# Security & Admin Authentication
JWT_SECRET="YOUR_RANDOM_SECRET_KEY_HERE"
JWT_EXPIRES_IN="8h"
SALT="YOUR_RANDOM_SALT_HERE"

# Third-Party OSINT API Gateway (Opsional)
HIBP_API_KEY=""
SERP_API_KEY=""
TELEGRAM_TOKEN=""
DUKCAPIL_KEY=""
